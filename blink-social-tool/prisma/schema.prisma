generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Multi-Tenant Clients (Your Customers)
model Client {
  id                String          @id @default(cuid())
  name              String
  logoChar          String          @default("A")
  logoUrl           String?         // Optional image URL for the logo

  enableReports     Boolean         @default(true)
  enableAiReplies   Boolean         @default(true)
  enabledFeatures   String[]        // e.g., ['dashboard', 'ticketing', 'post', 'activity', 'report'][cite: 7]
  allowedPlatforms  String[]        // e.g., ['whatsapp', 'instagram', 'tiktok', 'snapchat', 'facebook', 'x'][cite: 7]

  users             User[]
  socialAccounts    SocialAccount[]
  posts             Post[]          // Linked posts for publishing[cite: 7]
  reviews           Review[]        // Linked Google reviews[cite: 7]
  notifications     Notification[]  // Activity alerts and notifications[cite: 7]
  tickets           Ticket[]        // Linked support tickets[cite: 7]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("client") // "admin" or "client"[cite: 7]
  clientId  String?  // Optional so master admin doesn't require a client ID[cite: 7]
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// 2. Linked Social Media Accounts (Insta, TikTok, X, etc.)
model SocialAccount {
  id            String         @id @default(uuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  platform      String         // e.g., "whatsapp", "instagram", "tiktok", "snapchat", "facebook", "x"[cite: 7]
  platformId    String         // The ID given by the social platform[cite: 7]
  accessToken   String?        // OAuth token[cite: 7]
  conversations Conversation[]
  notifications Notification[] // Notifications for this social account[cite: 7]
}

// 3. The Unified Inbox Threads
model Conversation {
  id              String        @id @default(uuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  customerName    String
  customerHandle  String
  aiStatus        String        @default("active") // "active" or "paused" for human handoff[cite: 7]
  messages        Message[]
  tickets         Ticket[]      // Tickets generated from this conversation[cite: 7]
  updatedAt       DateTime      @updatedAt
}

// 4. Individual Messages
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  content        String
  senderType     String       // "customer", "ai", or "human"[cite: 7]
  createdAt      DateTime     @default(now())
}

// 5. Social Post Publishing Engine
model Post {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform    String   // e.g., "instagram", "facebook", "twitter"[cite: 7]
  content     String   // Caption or text content[cite: 7]
  mediaUrl    String?  // Attached image or video link[cite: 7]
  status      String   @default("published") // "published", "scheduled", "failed"[cite: 7]
  createdAt   DateTime @default(now())
}

// 6. Google Reviews Management & Engagement
model Review {
  id           String   @id @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewId     String   @unique // Unique ID provided by Google Business Profile[cite: 7]
  reviewerName String
  rating       Int      // 1 to 5 stars[cite: 7]
  comment      String?  // Customer review comment text[cite: 7]
  replyComment String?  // Business owner reply text[cite: 7]
  createTime   DateTime
  updatedAt    DateTime @updatedAt
}

// 7. Social Notifications (Updated with targetUrl for direct deep-linking)
model Notification {
  id              String         @id @default(uuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  
  type            String         // e.g., "COMMENT", "FOLLOW", "MENTION", "LIKE", "REVIEW", "TAG"[cite: 7]
  content         String         // e.g., "@johndoe commented on your latest post"[cite: 7]
  targetUrl       String?        // Direct deep-link to the comment, review, or profile[cite: 7]
  isRead          Boolean        @default(false)
  
  createdAt       DateTime       @default(now())
}

// 8. Support Tickets
model Ticket {
  id             String        @id @default(uuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  
  customerName   String
  contactDetails String
  city           String?
  source         String        // Auto-assigned (e.g., "whatsapp", "instagram")[cite: 7]
  category       String        // "Inquiry" or "Complaint"[cite: 7]
  details        String
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}