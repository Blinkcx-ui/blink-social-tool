generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Multi-Tenant Clients (Your Customers)
model Client {
  id                String          @id @default(cuid())
  name              String
  logoChar          String          @default("A")
  logoUrl           String?         // Optional image URL for the logo

  enableReports     Boolean         @default(true)
  enableAiReplies   Boolean         @default(true)
  enabledFeatures   String[]        // e.g., ['dashboard', 'ticketing', 'post', 'activity', 'report']
  allowedPlatforms  String[]        // e.g., ['whatsapp', 'instagram', 'tiktok', 'snapchat', 'facebook', 'x']

  // NEW: Escalation Matrix Configuration
  escalation1Email  String?
  escalation2Email  String?
  escalation2Hours  Int?            @default(4)
  escalation3Email  String?
  escalation3Hours  Int?            @default(24)
  
  // NEW: JSON to hold the dynamic cascading category tree
  ticketFields      Json?

  users             User[]
  socialAccounts    SocialAccount[]
  posts             Post[]          // Linked posts for publishing
  reviews           Review[]        // Linked Google reviews
  notifications     Notification[]  // Activity alerts and notifications
  tickets           Ticket[]        // Linked support tickets
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt @default(now())
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique  // UPDATED: Changed from email to username to match the new login flow
  password  String
  role      String   @default("client") // "admin" or "client"
  clientId  String?  // Optional so master admin doesn't require a client ID
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// 2. Linked Social Media Accounts (Insta, TikTok, X, etc.)
model SocialAccount {
  id            String         @id @default(uuid())
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  platform      String         // e.g., "whatsapp", "instagram", "tiktok", "snapchat", "facebook", "x"
  platformId    String         // The ID given by the social platform
  accessToken   String?        // OAuth token
  conversations Conversation[]
  notifications Notification[] // Notifications for this social account
}

// 3. The Unified Inbox Threads
model Conversation {
  id              String        @id @default(uuid())
  socialAccountId String
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id])
  customerName    String
  customerHandle  String
  
  // NEW: Stores the profile picture from Meta
  avatarUrl       String?       

  aiStatus        String        @default("active") // "active" or "paused" for human handoff
  messages        Message[]
  tickets         Ticket[]      // Tickets generated from this conversation
  updatedAt       DateTime      @updatedAt

  // NEW: Physically prevents duplicate chats from being created
  @@unique([socialAccountId, customerHandle])
}

// 4. Individual Messages
model Message {
  id             String       @id @default(uuid())
  conversationId String
  
  // UPDATED: Added onDelete: Cascade
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  content        String
  
  // NEW: Fields for file attachments (images, docs, videos)
  mediaUrl       String?      
  mediaType      String?      
  
  senderType     String       // "customer", "ai", or "human"
  createdAt      DateTime     @default(now())
}

// 5. Social Post Publishing Engine
model Post {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform    String   // e.g., "instagram", "facebook", "twitter"
  content     String   // Caption or text content
  mediaUrl    String?  // Attached image or video link
  status      String   @default("published") // "published", "scheduled", "failed"
  createdAt   DateTime @default(now())
}

// 6. Google Reviews Management & Engagement
model Review {
  id           String   @id @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewId     String   @unique // Unique ID provided by Google Business Profile
  reviewerName String
  rating       Int      // 1 to 5 stars
  comment      String?  // Customer review comment text
  replyComment String?  // Business owner reply text
  createTime   DateTime
  updatedAt    DateTime @updatedAt
}

// 7. Social Notifications (Updated with targetUrl for direct deep-linking)
model Notification {
  id              String         @id @default(uuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  socialAccountId String?
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  
  type            String         // e.g., "COMMENT", "FOLLOW", "MENTION", "LIKE", "REVIEW", "TAG"
  content         String         // e.g., "@johndoe commented on your latest post"
  targetUrl       String?        // Direct deep-link to the comment, review, or profile
  isRead          Boolean        @default(false)
  
  createdAt       DateTime       @default(now())
}

// 8. Support Tickets
model Ticket {
  id             String        @id @default(uuid())
  
  // NEW: Unique Ticket Number (default uuid ensures existing rows don't crash the database update)
  ticketNumber   String        @unique @default(uuid()) 
  
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  
  customerName   String
  contactDetails String
  city           String?
  source         String        // Auto-assigned (e.g., "whatsapp", "instagram")
  category       String        // "Inquiry" or "Complaint"
  details        String
  
  // NEW: Expanded Customer Profile Data
  mobile         String?
  email          String?
  socialAccount  String?       // Automatically pulled from inbox
  
  // NEW: Dynamic Ticket Information (4-Level Cascading)
  ticketType     String?
  category1      String?
  category2      String?
  category3      String?
  category4      String?
  
  // NEW: Status for the Escalation Matrix
  status         String        @default("Open") // "Open", "Escalated_Level1", "Escalated_Level2", "Closed"
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}